{
  "name": "telegram-logger",
  "version": "1.0.0",
  "description": "Program for recording and saving Telegram messages",
  "main": "index.js",
  "author": "aket0r",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aket0r/telegram-logger.git"
  },
  "bugs": {
    "url": "https://github.com/aket0r/telegram-logger/issues"
  },
  "homepage": "https://github.com/aket0r/telegram-logger#readme",
  "keywords": [
    "telegram",
    "tg",
    "logger"
  ],
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron": "^37.3.0",
    "vue": "^3.5.21",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aketor.telegramlogger",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "index.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "src/**/*",
      "!**/*.map",
      "!**/node_modules/*/{test,__tests__,example,examples}/**",
      "!**/.cache/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico",
      "artifactName": "Telegram-Logger-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons",
      "artifactName": "Telegram-Logger-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.icns",
      "artifactName": "Telegram-Logger-${version}-mac-${arch}.${ext}"
    },
    "publish": "never"
  }
}
